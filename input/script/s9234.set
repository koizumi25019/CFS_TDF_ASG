# set File

# set netlist(.v)
-net ./input/circuit/s9234.v

# set fault list(.txt)
-fault ./input/rprf/s9234_rpr_1.txt

# set xor-tap list(.txt)
-xor_tap ./input/xor_tap/tap_32.txt

# set scan-chain(.txt)
-scan_chain ./input/scan_chain/s9234_sc_32.txt

# set necessary(.txt)
-nece ./input/necessary/s9234_nece.txt

# set folder out(.txt)
-folder ./s9234_output/

# set seed set(.txt)
-seed s9234_seed.txt

# set target limit (value)
-target_limit 300

# set abort time (value)
-time 60

# set power mode (ON，OFF)
-power ON

# set parallel mode (value)
-parallel 24


