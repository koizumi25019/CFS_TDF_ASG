# set File

# set netlist(.v)
-net ./input/circuit/s15850.v

# set fault list(.txt)
-fault ./input/rprf/s15850_rpr_1.txt

# set xor-tap list(.txt)
-xor_tap ./input/xor_tap/tap_64.txt

# set scan-chain(.txt)
-scan_chain ./input/scan_chain/s15850_sc_64.txt

# set necessary(.txt)
-nece ./input/necessary/s15850_nece.txt

# set folder out(.txt)
-folder ./s15850_output/

# set seed set(.txt)
-seed s15850_seed.txt

# set target limit (value)
-target_limit 300

# set abort time (value)
-time 60

# set power mode (ON，OFF)
-power ON

# set parallel mode (value)
-parallel 24


