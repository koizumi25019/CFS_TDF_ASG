# set File

# set netlist(.v)
-net ./input/circuit/s27.v

# set fault list(.txt)
-fault ./input/rprf/s27_rpr_1.txt

# set xor-tap list(.txt)
-xor_tap ./input/xor_tap/tap_4.txt

# set scan-chain(.txt)
-scan_chain ./input/scan_chain/s27_sc_4.txt

# set folder out(.txt)
-folder ./s27_output/

# set target limit (value)
-target_limit 2

# set abort time (value)
-time 60

# set power mode (ON，OFF)
-power OFF

# set parallel mode (value)
-parallel 6

# set clasp mode 1 (ON，OFF)
#-mode_1 OFF

