# set File

# set netlist(.v)
-net ./input/circuit/s38417.v

# set fault list(.txt)
-fault ./input/rprf/s38417_rpr_1.txt

# set xor-tap list(.txt)
-xor_tap ./input/xor_tap/tap_64.txt

# set scan-chain(.txt)
-scan_chain ./input/scan_chain/s38417_sc_64.txt

# set folder out(.txt)
-folder ./s38417_output/

# set target limit (value)
-target_limit 300

# set abort time (value)
-time 60

# set power mode (ON，OFF)
-power ON

# set parallel mode (value)
-parallel 24

